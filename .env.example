# 0G Compute Router API Key (從 https://pc.0g.ai 取得並儲值；僅用於本地開發取得真實 AI 評論)
ZG_ROUTER_API_KEY=

# 0G Compute Router 端點
ZG_ROUTER_URL=https://router-api.0g.ai/v1

# 0G Galileo 測試網 RPC
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_CHAIN_ID=16602

# 0G ERC-8004 測試網合約位址
ZG_ERC8004_IDENTITY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ZG_ERC8004_REPUTATION=0x8004B663056A597Dffe9eCcC1965A193B7388713

# CAREER_OWNER_PRIVATE_KEY: 部署 CareerJury 合約與呼叫 settle() 所需的 EVM 私鑰。
# 取得方式：MetaMask → Account 1 旁邊的 "⋯" → Account details → Show private key → 複製 0x 開頭的 64 位 hex。
# 請勿將此值貼到聊天、截圖或提交到 Git；僅存放於本機 .env 檔案。
CAREER_OWNER_PRIVATE_KEY=
# CAREER_MANAGER_PRIVATE_KEY: 若使用舊版本地伺服器流程才需要；ERC-8004 合約流程由 CAREER_OWNER_PRIVATE_KEY 一併管理。
CAREER_MANAGER_PRIVATE_KEY=

CAREER_ENABLE_TRANSACTIONS=0
CAREER_MAX_LIVE_JOBS=1
CAREER_MODEL_A=0gm-1.0-35b-a3b
CAREER_MODEL_B=glm-5.3
CAREER_PROFESSOR_AGENT_ID=
CAREER_PROFESSOR_URL=
CAREER_ANTISOCIAL_AGENT_ID=
CAREER_ANTISOCIAL_URL=
CAREER_NEARMISS_AGENT_ID=
CAREER_NEARMISS_URL=
